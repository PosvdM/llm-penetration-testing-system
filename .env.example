# Optional LLM service. Leave the key empty to use rule-based fallback.
# Target information and scan evidence may be sent to this service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WIRE_API=chat_completions
LLM_REASONING_EFFORT=low

# Backend application metadata
APP_ENV=development
APP_NAME=LLM Penetration Testing System

# Listener and frontend settings read by start-dev.ps1.
# For manual startup, pass --host/--port to Uvicorn and use
# frontend/.env.local for VITE_API_BASE_URL.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
